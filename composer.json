{
    "name": "inwebo/markdown-bundle",
    "license": "GPL-3.0-or-later",
    "minimum-stability": "stable",
    "version": "1.0.0",
    "require": {
        "php": "^8.3",
        "inwebo/markdown": "^1.0",
        "symfony/framework-bundle": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.4",
        "friendsofphp/php-cs-fixer": "^3.89",
        "phpstan/phpstan": "^2.1"
    },
    "autoload": {
        "psr-4": {
            "Inwebo\\MarkdownBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Inwebo\\MarkdownBundle\\Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "inwebo",
            "email": "github@inwebo.net"
        }
    ],
    "extra": {
      "symfony": {
        "allow-contrib": false,
        "require": "8.*"
      }
    },
    "scripts": {
      "php-cs-fixer": "vendor/bin/php-cs-fixer --allow-risky=yes fix",
      "phpunit": "vendor/bin/phpunit --testdox",
      "phpstan": "vendor/bin/phpstan analyse src -c phpstan.neon"
    }
}
